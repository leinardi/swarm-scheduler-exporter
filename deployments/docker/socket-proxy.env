# Allowlist of the Docker API sections tecnativa/docker-socket-proxy v0.5.0 forwards to the
# daemon, for swarm-scheduler-exporter. Read by docker-compose.socket-proxy.yaml (env_file) and by
# the integration test TestSocketProxy_ExampleAllowlist, which runs the pinned proxy image with it.
#
# Every ACL variable of the image is set here, relying on no default: the image enables EVENTS and
# VERSION by default. The test fails if the image defines an ACL variable this file does not set.
#
# Scope: this makes the Docker API read-only for the exporter, not least-privilege. The proxy
# matches on a path prefix, so every enabled section allows every GET under it, and logs, specs and
# container files can hold secrets:
# - SERVICES=1 and TASKS=1, which the exporter always needs, also allow service and task logs
#   (/services/<id>/logs, /tasks/<id>/logs: the containers' logs, from across the Swarm), and the
#   service list the exporter reads carries every service spec, environment variables included;
# - CONTAINERS=1 allows container logs, stats, top, archive and export on this node.
# Setting CONTAINERS=0 narrows that, but log access stays. Exact per-endpoint rules would need a
# custom haproxy.cfg, which this example does not attempt.

# Needed by the exporter.
# PING: the client negotiates the API version through /_ping, so VERSION stays off.
PING=1
EVENTS=1
SERVICES=1
NODES=1
TASKS=1
# CONTAINERS: only for the -containers flag. Set it to 0 if you do not pass -containers.
CONTAINERS=1

# Not needed: denied.
ALLOW_RESTARTS=0
ALLOW_START=0
ALLOW_STOP=0
AUTH=0
BUILD=0
COMMIT=0
CONFIGS=0
DISTRIBUTION=0
EXEC=0
GRPC=0
IMAGES=0
INFO=0
NETWORKS=0
PLUGINS=0
# POST: 0 denies every method but GET (and HEAD), whatever the section.
POST=0
SECRETS=0
SESSION=0
SWARM=0
SYSTEM=0
VERSION=0
VOLUMES=0

# Referenced by the image's haproxy.cfg but not given a default in its environment: set to 0 anyway.
ALLOW_PAUSE=0
ALLOW_UNPAUSE=0
